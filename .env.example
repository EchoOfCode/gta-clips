# Copy this file to .env and replace placeholders with secure random values.
# NEVER commit .env to source control.

# Database credentials (SSD-backed)
POSTGRES_DB=gta_clip_engine
POSTGRES_USER=gta_clip
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TZ=Asia/Kolkata

# Container permissions
APP_UID=10001
APP_GID=10001

# Storage path: MUST be on the verified mounted 1 TB HDD (/mnt/data), not OS/root SSD.
MEDIA_ROOT=/mnt/data/gta-clip-engine

# API host binding port (bound to 127.0.0.1 on the host).
# Defaulted to 18090 to avoid collision with Beszel on 8090 and outreach-engine on 8000.
API_PORT=18090

# Internal authentication key for administrative/write operations (e.g., manual discovery trigger)
INTERNAL_API_KEY=REPLACE_WITH_A_SECURE_RANDOM_INTERNAL_KEY

# YouTube Data API v3 (Loaded exclusively from env; leave blank if unconfigured)
YOUTUBE_API_KEY=

# Twitch Helix API (Loaded exclusively from env; leave blank if unconfigured)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
