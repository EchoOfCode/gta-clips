# Copy this file to .env and replace the placeholder password.
POSTGRES_DB=gta_clip_engine
POSTGRES_USER=gta_clip
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
APP_UID=10001
APP_GID=10001

# This path must be on the mounted 1 TB HDD, not the OS/root filesystem.
MEDIA_ROOT=/mnt/data/gta-clip-engine

# API is bound to 127.0.0.1 only. Use SSH tunnelling or Tailscale Serve for remote access.
API_PORT=8090
TZ=Asia/Kolkata
